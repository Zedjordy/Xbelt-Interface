<Page
    x:Class="SettingsClone.Views.ScannerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:SettingsClone.Views.Controls"
    x:Name="RootPage">

    <ScrollViewer>



        <Grid Margin="40"
              MinWidth="250"
              RowSpacing="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Text="Scanner Configuration"
                FontSize="32"
                FontWeight="SemiBold"
                Margin="0,0,0,20"/>



            <!-- MASTER CARD -->
            <Border
                Grid.Row="1"
                CornerRadius="10"
                Padding="24"
                MinWidth="300"
                MaxWidth="800"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                <Grid RowSpacing="20">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
                            Content="+ Add Scanner"                    
                            FontWeight="Normal"
                            FontSize="16"
                            Background="DarkGreen"
                            HorizontalAlignment="Left"
                            Command="{Binding ViewModel.AddScannerCommand, ElementName=RootPage}"
                            CommandParameter="{Binding}"/>

                    <ItemsControl Grid.Row="1"
                        ItemsSource="{Binding Scanners}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <controls:Expander
                                    IsExpanded="False"
                                    ExpandDirection="Down"
                                    Margin="0,0,0,10"
                                    HorizontalAlignment="Stretch">

                                    <!-- HEADER STYLE WINDOWS SETTINGS -->
                                    <controls:Expander.Header >

                                        <Grid Height="Auto"
                                              Padding="10"
                                              CornerRadius="5">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock                                                
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left"
                                                    Text="{Binding Name}"
                                                    FontSize="20"
                                                    FontWeight="SemiBold"/>
                                            
                                            <!-- ENABLE -->
                                            <ToggleSwitch           
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                HorizontalContentAlignment="Stretch"
                                                HorizontalAlignment="Right"
                                                MinWidth="100"
                                                OnContent="Enabled"
                                                OffContent="Disabled"
                                                IsOn="{Binding IsEnabled, Mode=TwoWay}"/>

                                        </Grid>

                                    </controls:Expander.Header>
                                    <Grid RowSpacing="10">
                                        
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        
                                        <!-- NAME -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="Name"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="WrapWholeWords"/>
                                                
                                                <TextBlock Text="Device Name"
                                                           Opacity="0.7"
                                                           TextWrapping="WrapWholeWords"/>
                                            </StackPanel>
                                            
                                            <TextBox                                                
                                                Grid.Column="1"
                                                CornerRadius="1"
                                                Width="150"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"                                                    
                                                TextAlignment="Center"
                                                FontSize="20"
                                                FontWeight="SemiBold"/>
                                        </Grid>

                                        <Rectangle Grid.Row="1"
                                            Height="1"
                                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                        <!-- PROTOCOL -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="450"/>
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        HorizontalAlignment="Left" 
                                                        VerticalAlignment="Center"
                                                        Width="Auto">
                                                
                                                <TextBlock Text="Connection protocol"
                                                           FontWeight="SemiBold" 
                                                           TextLineBounds="Full" 
                                                           TextWrapping="WrapWholeWords"/>
                                                
                                                <TextBlock Text="Select TCP or UDP communication protocol."
                                                           Opacity="0.7"
                                                           TextWrapping="WrapWholeWords"/>
                                            </StackPanel>
                                            
                                            <StackPanel Spacing="1"
                                                        Orientation="Horizontal"
                                                        Grid.Column="1">
                                                
                                                <RadioButton Content="UDP"
                                                             BorderThickness="10"
                                                             IsChecked="{Binding IsUdp, Mode=TwoWay}"/>
                                                
                                                <RadioButton Content="TCP/IP"
                                                             IsChecked="{Binding IsTcp, Mode=TwoWay}"/>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <Grid Grid.Row="3">
                                            <controls:Expander
                                                IsExpanded="False"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch">
                                                
                                                <!-- HEADER STYLE WINDOWS SETTINGS -->
                                                <controls:Expander.Header>
                                                    
                                                    <Grid Padding="20">                                                        
                                                        <StackPanel Spacing="2">
                                                            
                                                            <TextBlock
                                                                Text="Ethernet configuration"
                                                                FontSize="16"
                                                                FontWeight="SemiBold"/>
                                                            
                                                            <Grid ColumnSpacing="20">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="100"/>
                                                                    <ColumnDefinition Width="100"/>
                                                                </Grid.ColumnDefinitions>
                                                                
                                                                <StackPanel
                                                                        Grid.Column="0">
                                                                        <TextBlock
                                                                            Text="IP:"
                                                                            FontSize="12"
                                                                            Opacity="0.7"/>
                                                                        
                                                                        <TextBlock
                                                                            Text="Subnet:"
                                                                            FontSize="12"
                                                                            Opacity="0.7"/>
                                                                        
                                                                        <TextBlock
                                                                            Text="Gateway:"
                                                                            FontSize="12"
                                                                            Opacity="0.7"/>
                                                                        
                                                                        <TextBlock
                                                                            Text="Server Port:"
                                                                            FontSize="12"
                                                                            Opacity="0.7"/>
                                                                        
                                                                        <TextBlock
                                                                            Text="Client Port:"
                                                                            FontSize="12"
                                                                            Opacity="0.7"/>
                                                                    </StackPanel>
                                                                
                                                                <StackPanel Grid.Column="1">
                                                                        <TextBlock
                                                                        Text="{Binding IpAddress}"
                                                                        FontSize="12"
                                                                        Opacity="0.7"/>

                                                                        <TextBlock
                                                                        Text="{Binding SubnetMask}"
                                                                        FontSize="12"
                                                                        Opacity="0.7"/>

                                                                        <TextBlock
                                                                        Text="{Binding Gateway}"
                                                                        FontSize="12"
                                                                        Opacity="0.7"/>

                                                                        <TextBlock
                                                                        Text="{Binding ServerPort}"
                                                                        FontSize="12"
                                                                        Opacity="0.7"/>

                                                                        <TextBlock
                                                                        Text="{Binding ClientPort}"
                                                                        FontSize="12"
                                                                        Opacity="0.7"/>
                                                                    </StackPanel>
                                                            </Grid>
                                                            
                                                        </StackPanel>
                                                        
                                                    </Grid>
                                                    
                                                </controls:Expander.Header>

                                                <!-- Ethernet Configuration -->
                                                <Grid Grid.Column="0"
                                                      Padding="20"
                                                      ColumnSpacing="50">
                                                    
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <StackPanel Grid.Column="0"
                                                                Spacing="20">
                                                        
                                                        <TextBox Header="IP Address"
                                                                 PlaceholderText="0.0.0.0"
                                                                 Text="{Binding IpAddress, Mode=TwoWay}"/>
                                                        
                                                        <TextBox Header="Subnet Mask"
                                                                 PlaceholderText="0.0.0.0"
                                                                 Text="{Binding SubnetMask, Mode=TwoWay}"/>
                                                        
                                                        <TextBox Header="Gateway"
                                                                 PlaceholderText="0.0.0.0"
                                                                 Text="{Binding Gateway, Mode=TwoWay}"/>
                                                        
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="1"
                                                                Spacing="20">
                                                        
                                                        <NumberBox Header="Server Port"
                                                                   Value="{Binding ServerPort, Mode=TwoWay}"
                                                                   Minimum="0"
                                                                   Maximum="65535"/>
                                                        
                                                        <NumberBox Header="Client Port"
                                                                   Value="{Binding ClientPort, Mode=TwoWay}"
                                                                   Minimum="0"
                                                                   Maximum="65535"/>
                                                    </StackPanel>
                                                    
                                                </Grid>
                                            </controls:Expander>
                                        </Grid>
                                        
                                        <Rectangle Grid.Row="4"
                                            Height="1"
                                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                        <Grid Grid.Row="5">

                                            <local:PageButton
                                                Title="RX / TX Message "
                                                Subtitle="Index, Barcode, Response message"
                                                IconLeft="Message"                            
                                                IconRight="Forward"
                                                Command="{Binding ViewModel.OpenSocketCommand, ElementName=RootPage}"
                                                CommandParameter="{Binding}"/>

                                        </Grid>


                                        <!-- RESPONSE SETTINGS -->
                                        <StackPanel Grid.Row="6">
                                            <controls:Expander
                                                IsExpanded="False"
                                                HorizontalAlignment="Stretch">

                                                <!-- HEADER STYLE WINDOWS SETTINGS -->
                                                <controls:Expander.Header>

                                                    <Grid Padding="20">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition MinWidth="850" MaxWidth="850" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Spacing="2">
                                                            <TextBlock
                                                                Text="Response configuration"
                                                                FontSize="16"
                                                                FontWeight="SemiBold"/>

                                                            <Grid ColumnSpacing="20">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="100"/>
                                                                    <ColumnDefinition Width="100"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel
                                                                    Grid.Column="0">
                                                                    <TextBlock
                                                                        Text="TX delay in ms:"
                                                                        FontSize="12"
                                                                        Opacity="0.7"/>                                                                    
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock
                                                                        Text="{Binding TxDelay}"
                                                                        FontSize="12"
                                                                        Opacity="0.7"/>
                                                                </StackPanel>
                                                            </Grid>

                                                        </StackPanel>

                                                    </Grid>

                                                </controls:Expander.Header>

                                                <!-- Response Configuration -->
                                                <Grid Padding="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition MinWidth="850" MaxWidth="850" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Spacing="20" 
                                                                    Margin="0,20,0,20" 
                                                                    MinWidth="350"
                                                                    HorizontalAlignment="Left"
                                                                    Grid.Column="0">

                                                        <NumberBox Header="Transmisison Response time delay (ms)"
                                                                 PlaceholderText="0ms"
                                                                 Text="{Binding TxDelay, Mode=TwoWay}"/>

                                                    </StackPanel>
                                                </Grid>

                                            </controls:Expander>
                                        </StackPanel>



                                        <Rectangle Grid.Row="7"
                                            Height="1"
                                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                        <!-- Save -->
                                        <Grid Grid.Row="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- LEFT -->
                                            <Button Content="Delete Scanner"
                                                FontWeight="SemiBold"
                                                Foreground="Black"
                                                Background="Goldenrod"
                                                HorizontalAlignment="Left"
                                                Command="{Binding ViewModel.RemoveScannerCommand, ElementName=RootPage}"
                                                CommandParameter="{Binding}"/>

                                            <!-- RIGHT -->
                                            <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="10">

                                                <Button Content="Cancel"/>
                                                <Button Content="Save"
                                                    Style="{ThemeResource AccentButtonStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </controls:Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

        </Grid>

    </ScrollViewer>

</Page>