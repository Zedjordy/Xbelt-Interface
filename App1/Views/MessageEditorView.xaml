<UserControl
    x:Class="SettingsClone.Views.MessageEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        CornerRadius="10"
        Padding="24"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

        <StackPanel Spacing="5">

            <!-- HEADER -->
            <Grid ColumnDefinitions="*,*,*"
                  RowDefinitions="Auto,Auto">

                <TextBlock
                    Text="{x:Bind Header}"
                    FontSize="32"
                    FontWeight="SemiBold"
                    Grid.ColumnSpan="3"
                    Margin="0,0,0,20"/>

                <TextBlock Text="Token Available"
                           Grid.Row="1"
                           Grid.Column="0"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBlock Text="MESSAGE"
                           Grid.Row="1"
                           Grid.Column="1"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Properties"
                           Grid.Row="1"
                           Grid.Column="2"
                           FontWeight="SemiBold"/>
            </Grid>

            <!-- BODY -->
            <Grid Padding="24"
                  ColumnDefinitions="*,*,*"
                  ColumnSpacing="20">

                <!-- AVAILABLE -->
                <ListView
					x:Name="AvailableList"
                    Grid.Column="0"
                    ItemsSource="{x:Bind AvailableTokens, Mode=OneWay}"
                    SelectedItem="{x:Bind SelectedToken, Mode=OneWay}"
                    DoubleTapped="Available_DoubleTapped"
                    Background="Transparent">

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10"
                                    Margin="4"
                                    CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <TextBlock Text="{Binding Name}" HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>

                <!-- MESSAGE -->
                <ListView
                    Grid.Column="1"
                    ItemsSource="{x:Bind MessageTokens}"
                    SelectedItem="{x:Bind SelectedToken, Mode=TwoWay}"
                    CanReorderItems="True"
                    AllowDrop="True"
                    ReorderMode="Enabled"
                    Background="Transparent"
                    DragItemsStarting="Message_DragStarting"
                    DragOver="Message_DragOver"
                    Drop="Message_Drop">

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10"
                                    Margin="4"
                                    CornerRadius="8"
                                    Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                <TextBlock Text="{Binding Name}" HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>

                <!-- PROPERTIES -->
                <StackPanel Grid.Column="2" Spacing="10">

                    <TextBlock Text="{Binding SelectedToken.Name, Mode=OneWay}"/>

                    <TextBox Text="{Binding SelectedToken.Value, Mode=TwoWay}"
                             PlaceholderText="Value (if applicable)"/>

                    <Button Content="Delete"
                            Click="Delete_Click"/>
                </StackPanel>

            </Grid>

            <!-- PREVIEW -->
            <Rectangle Height="1"
                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <StackPanel Spacing="10">

                <TextBlock Text="Preview"
                           FontWeight="SemiBold"/>

                <TextBox Text="{x:Bind Preview, Mode=OneWay}"
                         IsReadOnly="True"/>

            </StackPanel>

        </StackPanel>
    </Border>

</UserControl>