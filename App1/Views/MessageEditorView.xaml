<UserControl
    x:Class="SettingsClone.Views.MessageEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SettingsClone.Converters">

    <UserControl.Resources>
        <local:MessageTokenColorConvert x:Key="MessageTokenColorConvert"/>
    </UserControl.Resources>
    
    <Border
        CornerRadius="10"
        Padding="24"     
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

        <StackPanel Spacing="5">

            <!-- HEADER -->
            <Grid ColumnDefinitions="*,*,*"
                  RowDefinitions="Auto,Auto">

                <TextBlock
                    Text="{x:Bind Header}"
                    FontSize="32"
                    FontWeight="SemiBold"
                    Grid.ColumnSpan="3"
                    Margin="0,0,0,20"/>

                <TextBlock Text="Token Available"
                           Grid.Row="1"
                           Grid.Column="0"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBlock Text="MESSAGE"
                           Grid.Row="1"
                           Grid.Column="1"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Properties"
                           Grid.Row="1"
                           Grid.Column="2"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"/>
            </Grid>

            <!-- BODY -->
            <Grid Padding="24"
                  ColumnDefinitions="*,*,*"
                  ColumnSpacing="20"
                  MaxHeight="420">

                <!-- AVAILABLE -->
                <ListView
					x:Name="AvailableList"
                    Grid.Column="0"
                    ItemsSource="{x:Bind AvailableTokens, Mode=OneWay}"
                    DoubleTapped="Available_DoubleTapped"
                    Background="Transparent">

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10"
                                    Margin="4"
                                    CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <TextBlock Text="{Binding Name}" HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>

                <!-- MESSAGE -->
                <ScrollViewer
                    Grid.Column="1">
                    
                    <ListView
                        x:Name="MessageList"
                        ItemsSource="{x:Bind MessageTokens}"
                        SelectedItem="{x:Bind SelectedToken, Mode=TwoWay}"
                        CanReorderItems="True"
                        CanDragItems="True"
                        AllowDrop="True"
                        ReorderMode="Enabled"
                        Background="Transparent"
                        DragItemsStarting="Message_DragStarting"
                        DragOver="Message_DragOver"                                  
                        Drop="Message_Drop">
                        
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10"
                                        Margin="4"
                                        CornerRadius="8"                                        
                                        Background="{Binding Type, Converter={StaticResource MessageTokenColorConvert}}">
                                    <TextBlock Text="{Binding Name}" 
                                               HorizontalAlignment="Center"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        
                    </ListView>
                </ScrollViewer>

                <!-- PROPERTIES -->
                <StackPanel x:Name="PropertyPanel" Grid.Column="2" Spacing="10">

                    <Border Background="DarkSlateGray"
                            Padding="5">
                        
                    <TextBlock Text="{x:Bind SelectedToken.Name, Mode=OneWay}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               FontWeight="ExtraBold"
                               FontSize="18"/>
                    </Border>
                    
                    <!-- Lenght-->
                    <TextBlock 
                        Text="Length"
                        FontWeight="SemiBold"/>                    
                    <NumberBox 
                        Value="{x:Bind SelectedToken.Length, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"         
                        ValueChanged="NumberBox_ValueChanged"
                        PlaceholderText="Value (if applicable)"/>
                    
                    <!-- Value-->
                    <TextBlock 
                        Text="Value"
                        FontWeight="SemiBold"/>
                    <TextBox 
                        Text="{x:Bind SelectedToken.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Value (if applicable)"/>

                    <!-- Delete Token-->
                    <Button Content="Delete Token"
                            Background="IndianRed"
                            FontWeight="SemiBold"
                            Click="Delete_Click"/>
                </StackPanel>

            </Grid>

            <!-- PREVIEW -->
            <Rectangle Height="1"
                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <StackPanel Spacing="10">

                <TextBlock Text="Preview"
                           FontWeight="SemiBold"/>

                <TextBox Text="{x:Bind Preview, Mode=OneWay}"
                         IsReadOnly="True"/>

            </StackPanel>

        </StackPanel>
    </Border>

</UserControl>