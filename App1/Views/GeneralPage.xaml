<Page
    x:Class="SettingsClone.Views.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid Padding="16"
              MinWidth="250"
              RowSpacing="10">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Text="General Configuration"
                FontSize="24"
                FontWeight="SemiBold"
                Margin="0,0,0,20"/>

            <InfoBar
                x:Name="GlobalInfoBar"
                IsOpen="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="20"/>
            <!-- Ethernet Configuration -->
            <Grid Grid.Column="0"
              Padding="20"
              ColumnSpacing="50"
              RowSpacing="50">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Grid.Row="1"
                            Spacing="20">

                    <TextBox Header="Sorter PC - IP Address"
                             Width="200"
                             HorizontalAlignment="Left"
                             PlaceholderText="0.0.0.0"
                             Text="{Binding IpAddress, Mode=TwoWay}"/>

                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
    
    
    
    