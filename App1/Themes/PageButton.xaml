<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SettingsClone.Views.Controls">
    <!--<ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/PageButton.xaml"/>
	</ResourceDictionary.MergedDictionaries>-->

	<Style TargetType="local:PageButton">

		<!-- CONTROL DEFAULTS -->
		<Setter Property="Height" Value="64"/>
		<Setter Property="Padding" Value="16,10"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
		<Setter Property="Background" Value="Transparent"/>

		<Setter Property="Template">

			<Setter.Value>

				<ControlTemplate TargetType="local:PageButton">

					<Grid x:Name="RootGrid"
                          Padding="{TemplateBinding Padding}">


						<VisualStateManager.VisualStateGroups>

							<VisualStateGroup x:Name="CommonStates">

								<!-- NORMAL -->
								<VisualState x:Name="Normal">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid"
																	   Storyboard.TargetProperty="Background">
											<DiscreteObjectKeyFrame KeyTime="0"
												Value="#10FFFFFF"/>
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>

								<!-- HOVER -->
								<VisualState x:Name="PointerOver">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid"
																	   Storyboard.TargetProperty="Background">
											<DiscreteObjectKeyFrame KeyTime="0"
												Value="#15FFFFFF"/>
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>

								<!-- PRESSED -->
								<VisualState x:Name="Pressed">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid"
																	   Storyboard.TargetProperty="Background">
											<DiscreteObjectKeyFrame KeyTime="0"
												Value="#04FFFFFF"/>
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>

							</VisualStateGroup>

						</VisualStateManager.VisualStateGroups>


						<!-- LAYOUT -->
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<!-- ICON LEFT -->
						<SymbolIcon
                            Grid.Column="0"
                            Symbol="{Binding IconLeft, RelativeSource={RelativeSource TemplatedParent}}"
                            Width="24"
                            Height="24"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"/>

						<!-- TEXT -->
						<Grid Grid.Column="1"
                              VerticalAlignment="Center">

							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<TextBlock
                                Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}"
                                FontSize="16"
                                FontWeight="SemiBold"/>

							<TextBlock
                                Grid.Row="1"
                                Text="{Binding Subtitle, RelativeSource={RelativeSource TemplatedParent}}"
                                FontSize="12"
                                Opacity="0.7"/>
						</Grid>

						<!-- ICON RIGHT -->
						<SymbolIcon
                            Grid.Column="2"
                            Symbol="{Binding IconRight, RelativeSource={RelativeSource TemplatedParent}}"
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"/>

					</Grid>

				</ControlTemplate>

			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>